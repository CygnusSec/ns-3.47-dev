{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Debug ns-3 program in container",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${input:ns3Executable}",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build/lib"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Remote SSH: debug through Docker exec",
            "type": "cppdbg",
            "request": "launch",
            "program": "/workspace/ns-3/build/${input:ns3Executable}",
            "args": [],
            "stopAtEntry": true,
            "cwd": "/workspace/ns-3",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "/workspace/ns-3/build/lib"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "sourceFileMap": {
                "/workspace/ns-3": "${workspaceFolder}"
            },
            "pipeTransport": {
                "pipeCwd": "${workspaceFolder}",
                "pipeProgram": "docker",
                "pipeArgs": [
                    "compose",
                    "exec",
                    "-T",
                    "ns3",
                    "sh",
                    "-c"
                ],
                "debuggerPath": "/usr/bin/gdb"
            },
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Remote gdbserver: ns-3 first",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/remote-debug/ns3.47-first-debug",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/opt/homebrew/bin/gdb",
            "miDebuggerServerAddress": "${input:gdbServerAddress}",
            "sourceFileMap": {
                "/workspace/ns-3": "${workspaceFolder}"
            },
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Load Linux system libraries from gdbserver",
                    "text": "-gdb-set sysroot remote:",
                    "ignoreFailures": false
                },
                {
                    "description": "Load local ns-3 shared-library symbols",
                    "text": "-gdb-set solib-search-path ${workspaceFolder}/remote-debug/lib",
                    "ignoreFailures": false
                }
            ]
        },
        {
            "name": "(gdb) Launch from scratch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${relativeFileDirname}/ns3-dev-${fileBasenameNoExtension}-${input:buildType}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build/lib/"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(lldb) Launch from scratch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${relativeFileDirname}/ns3-dev-${fileBasenameNoExtension}-${input:buildType}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build/lib/"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb"
        },
        {
            "name": "(gdb) Launch testrunner",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/utils/ns3-dev-test-runner-${input:buildType}",
            "args": [
                "--suite=${selectedText}"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build/lib/"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(lldb) Launch testrunner",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/utils/ns3-dev-test-runner-${input:buildType}",
            "args": [
                "--suite=${selectedText}"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build/lib/"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb"
        }
    ],
    "inputs": [
        {
            "type": "promptString",
            "id": "ns3Executable",
            "description": "Executable path relative to the ns-3 build directory",
            "default": "examples/tutorial/ns3.47-first-debug"
        },
        {
            "type": "promptString",
            "id": "gdbServerAddress",
            "description": "Ubuntu gdbserver address (host:port)",
            "default": "192.168.1.100:2345"
        },
        {
            "type": "pickString",
            "id": "buildType",
            "description": "What is the build option?",
            "options": [
                "debug",
                "default",
                "optimized",
                "release",
                "minsizerel"
            ],
            "default": "default"
        }
    ]
}
